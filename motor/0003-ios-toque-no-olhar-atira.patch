+static void Touch_LookFireStop( void )
+{
+	if( lookfire.holding || lookfire.release_at )
+		Cbuf_AddText( "-attack\n" );
+
+	lookfire.holding = false;
+	lookfire.release_at = 0;
+}
+
+static void Touch_LookFireEvent( touchEventType type, int fingerID )
+{
+	const double now = host.realtime;
+
+	if( type == event_down )
+	{
+		if( !touch_look_fire.value || cls.key_dest != key_game || touch.state != state_none )
+			return;
+
+		// only a finger that started looking, and that did not also press a button
+		if( touch.look_finger != fingerID )
+			return;
+
+		for( const touch_button_t *b = touch.list_user.first; b; b = b->next )
+		{
+			if( b->finger == fingerID && b->type != touch_look )
+				return;
+		}
+
+		lookfire.finger = fingerID;
+		lookfire.down_time = now;
+		lookfire.travel = 0;
+
+		// second touch right after a tap: keep firing while the finger stays down
+		if( lookfire.last_tap > 0 && now - lookfire.last_tap < LOOKFIRE_DOUBLE )
+		{
+			if( lookfire.release_at )
+				lookfire.release_at = 0; // single shot still down, just keep it
+			else
+				Cbuf_AddText( "+attack\n" );
+
+			lookfire.holding = true;
+		}
+
+		lookfire.last_tap = 0;
+	}
+	else if( type == event_up )
+	{
+		if( fingerID != lookfire.finger )
+			return;
+
+		lookfire.finger = -1;
+
+		if( lookfire.holding )
+		{
+			lookfire.holding = false;
+			Cbuf_AddText( "-attack\n" );
+			return;
+		}
+
+		if( !touch_look_fire.value || cls.key_dest != key_game )
+			return;
+
+		// quick touch without dragging: one shot
+		if( now - lookfire.down_time < LOOKFIRE_TAP_TIME && lookfire.travel < LOOKFIRE_TAP_MOVE )
+		{
+			if( !lookfire.release_at )
+				Cbuf_AddText( "+attack\n" );
+
+			lookfire.release_at = now + LOOKFIRE_SHOT_TIME;
+			lookfire.last_tap = now;
+		}
+	}
+}
+
+static void Touch_LookFireFrame( void )
+{
+	if( lookfire.release_at && !lookfire.holding && host.realtime >= lookfire.release_at )
+	{
+		Cbuf_AddText( "-attack\n" );
+		lookfire.release_at = 0;
+	}
+
+	// finger lost (menu, editor, look reset or option turned off): never leave the weapon firing
+	if( lookfire.holding && ( touch.look_finger != lookfire.finger || cls.key_dest != key_game
+		|| touch.state != state_none || !touch_look_fire.value ))
+	{
+		Touch_LookFireStop();
+		lookfire.finger = -1;
+	}
+}
