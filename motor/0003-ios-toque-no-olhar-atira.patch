+// hlios: tap the look zone to fire once, double tap and hold to keep firing while aiming
+static CVAR_DEFINE_AUTO( touch_look_fire, "0", FCVAR_PRIVILEGED, "tap look zone to fire, double tap and hold to keep firing" );
+#define LOOKFIRE_TAP_TIME   0.25 // max finger down time for a tap
+#define LOOKFIRE_TAP_MOVE   0.02 // max finger travel for a tap, in screen fractions
+#define LOOKFIRE_DOUBLE     0.30 // max time between a tap and the next touch for double tap
+#define LOOKFIRE_SHOT_TIME  0.05 // how long +attack stays down for a single shot
+static struct
+{
+	int finger;        // finger being tracked on the look zone, -1 if none
+	double down_time;  // when it touched
+	float travel;      // how much it moved
+	double last_tap;   // when the last tap ended, 0 if none
+	double release_at; // when to send -attack for a single shot, 0 if none
+	qboolean holding;  // +attack held by double tap and hold
+} lookfire = { -1 };
