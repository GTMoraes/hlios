 #include "server.h"
 #include "platform/android/lib_android.h"
 
+#if XASH_IOS
+#include <sys/stat.h>
+
+/*
+==============
+IOS_FrameworkName
+
+hlios: App Store Connect refuses loose .dylib files inside an app (ITMS-90171), so the
+packaging (hlios scripts/embrulhar.py) moves every library to
+<bundle>/Frameworks/<name>.framework/<name>. <name> is the library path relative to the
+bundle, without the ".dylib" suffix, with each '/' turned into "__" and every character
+outside [A-Za-z0-9_-] turned into '_'. Both sides must derive the name the same way.
+==============
+*/
+static qboolean IOS_FrameworkName( const char *rel, char *out, size_t size )
+{
+	size_t len, i, j = 0;
+
+	while( rel[0] == '.' && ( rel[1] == '/' || rel[1] == '\\' ))
+		rel += 2;
+
+	len = Q_strlen( rel );
+
+	if( len > 6 && !Q_stricmp( rel + len - 6, ".dylib" ))
+		len -= 6;
+
+	for( i = 0; i < len; i++ )
+	{
+		const char c = rel[i];
+
+		if( j + 3 > size )
+			return false;
+
+		if( c == '/' || c == '\\' )
+		{
+			out[j++] = '_';
+			out[j++] = '_';
+		}
+		else if(( c >= 'a' && c <= 'z' ) || ( c >= 'A' && c <= 'Z' ) || ( c >= '0' && c <= '9' ) || c == '_' || c == '-' )
+			out[j++] = c;
+		else
+			out[j++] = '_';
+	}
+
+	out[j] = 0;
+	return j > 0;
+}
+
+static qboolean IOS_FrameworkPath( const char *rel, char *out, size_t size )
+{
+	char name[MAX_OSPATH];
+	struct stat st;
+
+	if( !IOS_FrameworkName( rel, name, sizeof( name )))
+		return false;
+
+	Q_snprintf( out, size, "%s/Frameworks/%s.framework/%s", IOS_GetExecDir(), name, name );
+
+	return stat( out, &st ) == 0 && S_ISREG( st.st_mode );
+}
+
+/*
+==============
+IOS_FindFramework
+
+Maps a library request of the engine to its framework inside the bundle
+==============
+*/
+static qboolean IOS_FindFramework( const char *dllname, char *out, size_t size )
+{
+	const char *bundle = IOS_GetExecDir();
+	const size_t bundlelen = Q_strlen( bundle );
+	char rel[MAX_OSPATH];
+
+	if( COM_StringEmptyOrNULL( dllname ) || COM_StringEmptyOrNULL( bundle ))
+		return false;
+
+	// absolute path: only the ones inside the app bundle
+	if( dllname[0] == '/' )
+	{
+		if( !Q_strncmp( dllname, bundle, bundlelen ) && dllname[bundlelen] == '/' )
+			return IOS_FrameworkPath( dllname + bundlelen + 1, out, size );
+
+		return false;
+	}
+
+	// bare file name: engine library at the bundle root (filesystem_stdio, ref_*, menu)
+	if( !Q_strchr( dllname, '/' ) && !Q_strchr( dllname, '\\' ))
+		return IOS_FrameworkPath( dllname, out, size );
+
+	// game library, relative to a game directory: the running game, its base game, then valve
+	// (the libraries in valve also serve mods that don't have their own, like Blue Shift)
+	if( FI != NULL && FI->GameInfo != NULL )
+	{
+		const char *dirs[3];
+		int i;
+
+		dirs[0] = FI->GameInfo->gamefolder;
+		dirs[1] = FI->GameInfo->basedir;
+		dirs[2] = "valve";
+
+		for( i = 0; i < 3; i++ )
+		{
+			if( COM_StringEmptyOrNULL( dirs[i] ))
+				continue;
+
+			Q_snprintf( rel, sizeof( rel ), "%s/%s", dirs[i], dllname );
+
+			if( IOS_FrameworkPath( rel, out, size ))
+				return true;
+		}
+	}
+
+	// maybe relative to the bundle already (e.g. -dll valve/dlls/hl_ios_arm64.dylib)
+	return IOS_FrameworkPath( dllname, out, size );
+}
+
+qboolean IOS_LibraryExists( const char *dllname )
+{
+	char path[MAX_OSPATH];
+
+	return IOS_FindFramework( dllname, path, sizeof( path ));
+}
+#endif // XASH_IOS
+
