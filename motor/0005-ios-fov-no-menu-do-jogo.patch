+void CMenuVidOptions::AtualizarTextosFov( void )
+{
+	int mundo = (int)( fovMundo.CvarValue() + 0.5f );
+	int armas = (int)( fovArmas.CvarValue() + 0.5f );
+	int mao = (int)( fovArmaMao.CvarValue() + 0.5f );
+
+	snprintf( textoFovMundo, sizeof( textoFovMundo ), "Field of view: %d%s", mundo, mundo == 90 ? " (original)" : "" );
+
+	if( armas < 10 )
+		snprintf( textoFovArmas, sizeof( textoFovArmas ), "Weapon FOV: same as view" );
+	else
+		snprintf( textoFovArmas, sizeof( textoFovArmas ), "Weapon FOV: %d%s", armas, armas == 90 ? " (original)" : "" );
+
+	if( !EngFuncs::ClientInGame( ))
+		snprintf( textoFovArmaMao, sizeof( textoFovArmaMao ), "Weapon in hand FOV: start a game first" );
+	else if( mao < 10 )
+		snprintf( textoFovArmaMao, sizeof( textoFovArmaMao ), "Weapon in hand FOV: same as Weapon FOV" );
+	else
+		snprintf( textoFovArmaMao, sizeof( textoFovArmaMao ), "Weapon in hand FOV: %d", mao );
+}
