diff --git a/ref/gl/gl_studio.c b/ref/gl/gl_studio.c
index 39873fb..7a52ba3 100644
--- a/ref/gl/gl_studio.c
+++ b/ref/gl/gl_studio.c
@@ -3319,9 +3319,322 @@ void R_RunViewmodelEvents( void )
 R_DrawViewModel
 =================
 */
+/*
+=============
+R_ViewModelProjection
+
+hlios: projeção própria para a arma em primeira pessoa (r_viewmodel_fov), com o mesmo cálculo do mundo:
+o fov vale para uma tela 4:3 e a tela larga só abre os lados (V_CalcFov e V_AdjustFov no cl_view.c)
+=============
+*/
+/*
+=============
+R_FovArma
+
+hlios: campo de visão e posição próprios de cada arma, guardados em fov_armas.txt, na pasta do jogo,
+por modelo: o nome e o tamanho do arquivo, para que um modelo trocado (o de uma pasta _addon ou _hd)
+tenha os seus. As cvars mostram os valores da arma na mão; mudar uma delas (no console, no menu ou
+com o ajustar_arma dos botões) muda a da arma na mão.
+  fov_arma     campo de visão (abaixo de 10 vale o r_viewmodel_fov)
+  arma_frente  para a frente (positivo) ou para trás, em unidades do jogo
+  arma_lado    para a direita (positivo) ou para a esquerda
+  arma_altura  para cima (positivo) ou para baixo
+Só muda o desenho da arma: a mira e os tiros continuam iguais.
+=============
+*/
+#define FOVARMA_ARQUIVO	"fov_armas.txt"
+#define FOVARMA_MAX	128
+#define FOVARMA_CHAVE	96
+#define FOVARMA_VALORES	4	// fov, frente, lado, altura
+
+typedef struct
+{
+	char	chave[FOVARMA_CHAVE];
+	float	v[FOVARMA_VALORES];
+} fovarma_t;
+
+static convar_t	*fovarma_cvars[FOVARMA_VALORES] = { &fov_arma, &arma_frente, &arma_lado, &arma_altura };
+static fovarma_t	fovarmas[FOVARMA_MAX];
+static int		numfovarmas;
+static char		fovarmas_jogo[64];		// pasta do jogo da lista carregada
+static char		fovarma_mao[FOVARMA_CHAVE];	// modelo da arma na mão
+static float		fovarma_visto[FOVARMA_VALORES];	// os valores das cvars na última olhada
+
+static qboolean R_FovArmaVazia( const float *v )
+{
+	return v[0] < 10.0f && v[1] == 0.0f && v[2] == 0.0f && v[3] == 0.0f;
+}
+
+static void R_FovArmaCarregar( void )
+{
+	const char *jogo = gEngfuncs.fsapi->Gamedir();
+	char linha[256], nome[FOVARMA_CHAVE];
+	float v[FOVARMA_VALORES];
+	file_t *f;
+	int c, n;
+
+	if( !jogo || !Q_strcmp( jogo, fovarmas_jogo ))
+		return;
+
+	Q_strncpy( fovarmas_jogo, jogo, sizeof( fovarmas_jogo ));
+	numfovarmas = 0;
+	fovarma_mao[0] = 0;
+
+	if(( f = gEngfuncs.fsapi->Open( FOVARMA_ARQUIVO, "r", true )) == NULL )
+		return;
+
+	do
+	{
+		c = gEngfuncs.fsapi->Gets( f, linha, sizeof( linha ));
+		v[1] = v[2] = v[3] = 0.0f;
+
+		// as linhas da 0.1.14 só têm o fov
+		n = sscanf( linha, "%95s %f %f %f %f", nome, &v[0], &v[1], &v[2], &v[3] );
+
+		// uma linha zerada vale: ela tira, para um modelo, os valores copiados ("nome:*")
+		if( numfovarmas < FOVARMA_MAX && n >= 2 )
+		{
+			if( v[0] < 10.0f )
+				v[0] = 0.0f;
+
+			Q_strncpy( fovarmas[numfovarmas].chave, nome, FOVARMA_CHAVE );
+			memcpy( fovarmas[numfovarmas].v, v, sizeof( v ));
+			numfovarmas++;
+		}
+	} while( c >= 0 );
+
+	gEngfuncs.fsapi->Close( f );
+}
+
+static void R_FovArmaSalvar( void )
+{
+	file_t *f;
+	int i;
+
+	if(( f = gEngfuncs.fsapi->Open( FOVARMA_ARQUIVO, "w", true )) == NULL )
+		return;
+
+	gEngfuncs.fsapi->Print( f, "// hlios: cada arma (modelo:tamanho), com fov_arma, arma_frente, arma_lado e arma_altura\n" );
+
+	for( i = 0; i < numfovarmas; i++ )
+	{
+		gEngfuncs.fsapi->Printf( f, "%s %g %g %g %g\n", fovarmas[i].chave,
+			fovarmas[i].v[0], fovarmas[i].v[1], fovarmas[i].v[2], fovarmas[i].v[3] );
+	}
+
+	gEngfuncs.fsapi->Close( f );
+}
+
+// tem valores copiados de outro jogo ("nome:*") para este modelo?
+static qboolean R_FovArmaTemCopia( const char *nome )
+{
+	char geral[FOVARMA_CHAVE];
+	int i;
+
+	Q_snprintf( geral, sizeof( geral ), "%s:*", nome );
+
+	for( i = 0; i < numfovarmas; i++ )
+	{
+		if( !Q_stricmp( fovarmas[i].chave, geral ))
+			return true;
+	}
+
+	return false;
+}
+
+// confere a arma na mão e as cvars; devolve em v os valores que valem para ela
+static void R_FovArma( float *v )
+{
+	model_t *mod = RI.currententity->model;
+	studiohdr_t *hdr = NULL;
+	char chave[FOVARMA_CHAVE];
+	qboolean mudou = false;
+	int i, j;
+
+	if( mod->type == mod_studio )
+		hdr = (studiohdr_t *)gEngfuncs.Mod_Extradata( mod_studio, mod );
+
+	R_FovArmaCarregar();
+	Q_snprintf( chave, sizeof( chave ), "%s:%d", mod->name, hdr ? (int)hdr->length : 0 );
+
+	for( i = 0; i < numfovarmas; i++ )
+	{
+		if( !Q_strcmp( fovarmas[i].chave, chave ))
+			break;
+	}
+
+	if( Q_strcmp( chave, fovarma_mao ))
+	{
+		// outra arma na mão: as cvars passam a mostrar os valores dela. Sem os do modelo exato, valem os
+		// copiados de outro jogo pelo app, gravados como "nome:*" (as mãos mudam de jogo para jogo, e o
+		// tamanho do arquivo junto)
+		int copia = i;
+		char geral[FOVARMA_CHAVE];
+
+		Q_strncpy( fovarma_mao, chave, sizeof( fovarma_mao ));
+
+		if( i >= numfovarmas )
+		{
+			Q_snprintf( geral, sizeof( geral ), "%s:*", mod->name );
+
+			for( copia = 0; copia < numfovarmas; copia++ )
+			{
+				if( !Q_stricmp( fovarmas[copia].chave, geral ))
+					break;
+			}
+		}
+
+		for( j = 0; j < FOVARMA_VALORES; j++ )
+		{
+			v[j] = ( copia < numfovarmas ) ? fovarmas[copia].v[j] : 0.0f;
+
+			if( fabs( v[j] - fovarma_cvars[j]->value ) > 0.001f )
+				gEngfuncs.Cvar_SetValue( fovarma_cvars[j]->name, v[j] );
+
+			fovarma_visto[j] = v[j];
+		}
+		return;
+	}
+
+	for( j = 0; j < FOVARMA_VALORES; j++ )
+	{
+		v[j] = fovarma_cvars[j]->value;
+
+		if( fabs( v[j] - fovarma_visto[j] ) > 0.001f )
+			mudou = true;
+
+		fovarma_visto[j] = v[j];
+	}
+
+	if( !mudou )
+		return;
+
+	// mudaram uma cvar: vale para a arma na mão. Zerada, a linha sai, a não ser que tenha valores
+	// copiados para o mesmo nome: aí fica zerada, para eles não voltarem
+	if( R_FovArmaVazia( v ) && !R_FovArmaTemCopia( mod->name ))
+	{
+		if( i < numfovarmas )
+			fovarmas[i] = fovarmas[--numfovarmas];
+	}
+	else
+	{
+		if( i >= numfovarmas )
+		{
+			if( numfovarmas >= FOVARMA_MAX )
+				return;
+
+			i = numfovarmas++;
+			Q_strncpy( fovarmas[i].chave, chave, FOVARMA_CHAVE );
+		}
+
+		memcpy( fovarmas[i].v, v, sizeof( fovarmas[i].v ));
+
+		if( fovarmas[i].v[0] < 10.0f )
+			fovarmas[i].v[0] = 0.0f;
+	}
+
+	R_FovArmaSalvar();
+}
+
+/*
+=============
+R_AjustarArma_f
+
+hlios: ajustar_arma <frente|lado|altura|fov> <passo>, ou ajustar_arma zerar (para os botões de ajuste)
+=============
+*/
+void R_AjustarArma_f( void )
+{
+	const char *qual = gEngfuncs.Cmd_Argv( 1 );
+	float passo = Q_atof( gEngfuncs.Cmd_Argv( 2 ));
+	float fov;
+
+	if( gEngfuncs.Cmd_Argc() < 2 )
+	{
+		gEngfuncs.Con_Printf( "ajustar_arma <frente|lado|altura|fov> <passo>, ou ajustar_arma zerar\n" );
+		return;
+	}
+
+	if( !Q_stricmp( qual, "zerar" ))
+	{
+		gEngfuncs.Cvar_SetValue( fov_arma.name, 0.0f );
+		gEngfuncs.Cvar_SetValue( arma_frente.name, 0.0f );
+		gEngfuncs.Cvar_SetValue( arma_lado.name, 0.0f );
+		gEngfuncs.Cvar_SetValue( arma_altura.name, 0.0f );
+	}
+	else if( !Q_stricmp( qual, "frente" ))
+		gEngfuncs.Cvar_SetValue( arma_frente.name, bound( -30.0f, arma_frente.value + passo, 30.0f ));
+	else if( !Q_stricmp( qual, "lado" ))
+		gEngfuncs.Cvar_SetValue( arma_lado.name, bound( -30.0f, arma_lado.value + passo, 30.0f ));
+	else if( !Q_stricmp( qual, "altura" ))
+		gEngfuncs.Cvar_SetValue( arma_altura.name, bound( -30.0f, arma_altura.value + passo, 30.0f ));
+	else if( !Q_stricmp( qual, "fov" ))
+	{
+		// parte do fov que vale agora para a arma (o dela, o das armas ou o do mundo)
+		fov = fov_arma.value;
+		if( fov < 10.0f )
+			fov = r_viewmodel_fov.value;
+		if( fov < 10.0f )
+			fov = 90.0f;
+
+		gEngfuncs.Cvar_SetValue( fov_arma.name, bound( 10.0f, fov + passo, 120.0f ));
+	}
+	else
+	{
+		gEngfuncs.Con_Printf( "ajustar_arma: use frente, lado, altura, fov ou zerar\n" );
+		return;
+	}
+
+	{
+		char fovtexto[16], texto[128];
+
+		if( fov_arma.value >= 10.0f )
+			Q_snprintf( fovtexto, sizeof( fovtexto ), "%g", fov_arma.value );
+		else
+			Q_strncpy( fovtexto, "geral", sizeof( fovtexto ));
+
+		Q_snprintf( texto, sizeof( texto ), "Arma: frente %g, lado %g, altura %g, FOV %s",
+			arma_frente.value, arma_lado.value, arma_altura.value, fovtexto );
+		gEngfuncs.CL_CenterPrint( texto, 0.25f );
+	}
+}
+
+static qboolean R_ViewModelProjection( float fov )
+{
+	matrix4x4 m;
+	GLfloat zNear = 4.0f, zFar, yMax, xMax, aspecto;
+
+	if( fov < 10.0f )
+		fov = r_viewmodel_fov.value;
+
+	// abaixo de 10, a arma usa a projeção do mundo
+	if( fov < 10.0f || FBitSet( RI.rvp.flags, RF_DRAW_OVERVIEW ))
+		return false;
+
+	fov = bound( 10.0f, fov, 170.0f );
+	zFar = Q_max( 256.0f, RI.farClip );
+	aspecto = tan( RI.rvp.fov_x * M_PI_F / 360.0f ) / tan( RI.rvp.fov_y * M_PI_F / 360.0f );
+	yMax = zNear * tan( fov * M_PI_F / 360.0f ) * ( 480.0f / 640.0f );
+	xMax = yMax * aspecto;
+
+	if( tr.rotation & 1 )
+		Matrix4x4_CreateProjection( m, yMax, -yMax, xMax, -xMax, zNear, zFar );
+	else
+		Matrix4x4_CreateProjection( m, xMax, -xMax, yMax, -yMax, zNear, zFar );
+
+	pglMatrixMode( GL_PROJECTION );
+	GL_LoadMatrix( m );
+	pglMatrixMode( GL_MODELVIEW );
+
+	return true;
+}
+
 void R_DrawViewModel( void )
 {
 	cl_entity_t	*view = tr.viewent;
+	qboolean	fovProprio;
+	float		arma[FOVARMA_VALORES];
+	vec3_t		origemOriginal;
 
 	R_GatherPlayerLight( view );
 
@@ -3348,6 +3661,14 @@ void R_DrawViewModel( void )
 	pglDepthRange( gldepthmin, gldepthmin + VIEWMODEL_DEPTH_RANGE * ( gldepthmax - gldepthmin ));
 	RI.currentmodel = RI.currententity->model;
 
+	// hlios: fov e posição da arma na mão (R_FovArma); a posição anda junto com a câmera
+	R_FovArma( arma );
+	VectorCopy( RI.currententity->origin, origemOriginal );
+	VectorMA( RI.currententity->origin, arma[1], RI.vforward, RI.currententity->origin );
+	VectorMA( RI.currententity->origin, arma[2], RI.vright, RI.currententity->origin );
+	VectorMA( RI.currententity->origin, arma[3], RI.vup, RI.currententity->origin );
+	fovProprio = R_ViewModelProjection( arma[0] );
+
 	switch( RI.currententity->model->type )
 	{
 	case mod_alias:
@@ -3361,6 +3682,15 @@ void R_DrawViewModel( void )
 
 	// restore depth range
 	pglDepthRange( gldepthmin, gldepthmax );
+	VectorCopy( origemOriginal, RI.currententity->origin );
+
+	// hlios: volta a projeção do mundo
+	if( fovProprio )
+	{
+		pglMatrixMode( GL_PROJECTION );
+		GL_LoadMatrix( RI.projectionMatrix );
+		pglMatrixMode( GL_MODELVIEW );
+	}
 }
 
