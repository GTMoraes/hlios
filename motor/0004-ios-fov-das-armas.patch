 R_DrawViewModel
 =================
 */
+/*
+=============
+R_ViewModelProjection
+
+hlios: projeção própria para a arma em primeira pessoa (r_viewmodel_fov), com o mesmo cálculo do mundo:
+o fov vale para uma tela 4:3 e a tela larga só abre os lados (V_CalcFov e V_AdjustFov no cl_view.c)
+=============
+*/
+/*
+=============
+R_FovArma
+
+hlios: campo de visão próprio de cada arma (cvar fov_arma; abaixo de 10 vale o r_viewmodel_fov).
+Fica em fov_armas.txt, na pasta do jogo, por modelo: o nome e o tamanho do arquivo, para que um
+modelo trocado (o de uma pasta _addon ou _hd) tenha o seu. O cvar mostra o valor da arma na mão;
+mudar o cvar (no console ou no menu) muda o da arma na mão.
+=============
+*/
+#define FOVARMA_ARQUIVO	"fov_armas.txt"
+#define FOVARMA_MAX	128
+#define FOVARMA_CHAVE	96
+
+typedef struct
+{
+	char	chave[FOVARMA_CHAVE];
+	float	fov;
+} fovarma_t;
+
+static fovarma_t	fovarmas[FOVARMA_MAX];
+static int		numfovarmas;
+static char		fovarmas_jogo[64];		// pasta do jogo da lista carregada
+static char		fovarma_mao[FOVARMA_CHAVE];	// modelo da arma na mão
+static float		fovarma_visto;			// o valor do cvar na última olhada
+
+static void R_FovArmaCarregar( void )
+{
+	const char *jogo = gEngfuncs.fsapi->Gamedir();
+	char linha[256], nome[FOVARMA_CHAVE];
+	file_t *f;
+	float fov;
+	int c;
+
+	if( !jogo || !Q_strcmp( jogo, fovarmas_jogo ))
+		return;
+
+	Q_strncpy( fovarmas_jogo, jogo, sizeof( fovarmas_jogo ));
+	numfovarmas = 0;
+	fovarma_mao[0] = 0;
+
+	if(( f = gEngfuncs.fsapi->Open( FOVARMA_ARQUIVO, "r", true )) == NULL )
+		return;
+
+	do
+	{
+		c = gEngfuncs.fsapi->Gets( f, linha, sizeof( linha ));
+
+		if( numfovarmas < FOVARMA_MAX && sscanf( linha, "%95s %f", nome, &fov ) == 2 && fov >= 10.0f )
+		{
+			Q_strncpy( fovarmas[numfovarmas].chave, nome, FOVARMA_CHAVE );
+			fovarmas[numfovarmas].fov = fov;
+			numfovarmas++;
+		}
+	} while( c >= 0 );
+
+	gEngfuncs.fsapi->Close( f );
+}
+
+static void R_FovArmaSalvar( void )
+{
+	file_t *f;
+	int i;
+
+	if(( f = gEngfuncs.fsapi->Open( FOVARMA_ARQUIVO, "w", true )) == NULL )
+		return;
+
+	gEngfuncs.fsapi->Print( f, "// hlios: campo de visao de cada arma (no console: fov_arma, com a arma na mao)\n" );
+
+	for( i = 0; i < numfovarmas; i++ )
+		gEngfuncs.fsapi->Printf( f, "%s %g\n", fovarmas[i].chave, fovarmas[i].fov );
+
+	gEngfuncs.fsapi->Close( f );
+}
+
+static float R_FovArma( void )
+{
+	model_t *mod = RI.currententity->model;
+	studiohdr_t *hdr = (studiohdr_t *)gEngfuncs.Mod_Extradata( mod_studio, mod );
+	char chave[FOVARMA_CHAVE];
+	float v = fov_arma.value;
+	int i;
+
+	R_FovArmaCarregar();
+	Q_snprintf( chave, sizeof( chave ), "%s:%d", mod->name, hdr ? (int)hdr->length : 0 );
+
+	for( i = 0; i < numfovarmas; i++ )
+	{
+		if( !Q_strcmp( fovarmas[i].chave, chave ))
+			break;
+	}
+
+	if( Q_strcmp( chave, fovarma_mao ))
+	{
+		// outra arma na mão: o cvar passa a mostrar o valor dela
+		Q_strncpy( fovarma_mao, chave, sizeof( fovarma_mao ));
+		v = ( i < numfovarmas ) ? fovarmas[i].fov : 0.0f;
+
+		if( fabs( v - fov_arma.value ) > 0.01f )
+			gEngfuncs.Cvar_SetValue( fov_arma.name, v );
+	}
+	else if( fabs( v - fovarma_visto ) > 0.01f )
+	{
+		// mudaram o cvar: vale para a arma na mão
+		if( v < 10.0f )
+		{
+			if( i < numfovarmas )
+				fovarmas[i] = fovarmas[--numfovarmas];
+		}
+		else if( i < numfovarmas )
+			fovarmas[i].fov = v;
+		else if( numfovarmas < FOVARMA_MAX )
+		{
+			Q_strncpy( fovarmas[numfovarmas].chave, chave, FOVARMA_CHAVE );
+			fovarmas[numfovarmas].fov = v;
+			numfovarmas++;
+		}
+
+		R_FovArmaSalvar();
+	}
+
+	fovarma_visto = v;
+	return v;
+}
+
+static qboolean R_ViewModelProjection( void )
+{
+	matrix4x4 m;
+	float fov = R_FovArma();
+	GLfloat zNear = 4.0f, zFar, yMax, xMax, aspecto;
+
+	if( fov < 10.0f )
+		fov = r_viewmodel_fov.value;
+
+	// abaixo de 10, a arma usa a projeção do mundo
+	if( fov < 10.0f || FBitSet( RI.rvp.flags, RF_DRAW_OVERVIEW ))
+		return false;
+
+	fov = bound( 10.0f, fov, 170.0f );
+	zFar = Q_max( 256.0f, RI.farClip );
+	aspecto = tan( RI.rvp.fov_x * M_PI_F / 360.0f ) / tan( RI.rvp.fov_y * M_PI_F / 360.0f );
+	yMax = zNear * tan( fov * M_PI_F / 360.0f ) * ( 480.0f / 640.0f );
+	xMax = yMax * aspecto;
+
+	if( tr.rotation & 1 )
+		Matrix4x4_CreateProjection( m, yMax, -yMax, xMax, -xMax, zNear, zFar );
+	else
+		Matrix4x4_CreateProjection( m, xMax, -xMax, yMax, -yMax, zNear, zFar );
+
+	pglMatrixMode( GL_PROJECTION );
+	GL_LoadMatrix( m );
+	pglMatrixMode( GL_MODELVIEW );
+
+	return true;
+}
+
 void R_DrawViewModel( void )
 {
 	cl_entity_t	*view = tr.viewent;
+	qboolean	fovProprio;
 
 	R_GatherPlayerLight( view );
 
