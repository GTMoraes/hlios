+/*
+=============
+R_ViewModelProjection
+
+hlios: projeção própria para a arma em primeira pessoa (r_viewmodel_fov), com o mesmo cálculo do mundo:
+o fov vale para uma tela 4:3 e a tela larga só abre os lados (V_CalcFov e V_AdjustFov no cl_view.c)
+=============
+*/
+static qboolean R_ViewModelProjection( void )
+{
+	matrix4x4 m;
+	float fov = r_viewmodel_fov.value;
+	GLfloat zNear = 4.0f, zFar, yMax, xMax, aspecto;
+
+	if( fov <= 0.0f || FBitSet( RI.rvp.flags, RF_DRAW_OVERVIEW ))
+		return false;
+
+	fov = bound( 10.0f, fov, 170.0f );
+	zFar = Q_max( 256.0f, RI.farClip );
+	aspecto = tan( RI.rvp.fov_x * M_PI_F / 360.0f ) / tan( RI.rvp.fov_y * M_PI_F / 360.0f );
+	yMax = zNear * tan( fov * M_PI_F / 360.0f ) * ( 480.0f / 640.0f );
+	xMax = yMax * aspecto;
+
+	if( tr.rotation & 1 )
+		Matrix4x4_CreateProjection( m, yMax, -yMax, xMax, -xMax, zNear, zFar );
+	else
+		Matrix4x4_CreateProjection( m, xMax, -xMax, yMax, -yMax, zNear, zFar );
+
+	pglMatrixMode( GL_PROJECTION );
+	GL_LoadMatrix( m );
+	pglMatrixMode( GL_MODELVIEW );
+
+	return true;
+}
+
 void R_DrawViewModel( void )
 {
 	cl_entity_t	*view = tr.viewent;
+	qboolean	fovProprio;
 
 	R_GatherPlayerLight( view );
 
@@ -3347,6 +3383,7 @@ void R_DrawViewModel( void )
 	// adjust the depth range to prevent view model from poking into walls
 	pglDepthRange( gldepthmin, gldepthmin + VIEWMODEL_DEPTH_RANGE * ( gldepthmax - gldepthmin ));
 	RI.currentmodel = RI.currententity->model;
+	fovProprio = R_ViewModelProjection();
 
 	switch( RI.currententity->model->type )
 	{
@@ -3361,6 +3398,14 @@ void R_DrawViewModel( void )
 
 	// restore depth range
 	pglDepthRange( gldepthmin, gldepthmax );
+
+	// hlios: volta a projeção do mundo
+	if( fovProprio )
+	{
+		pglMatrixMode( GL_PROJECTION );
+		GL_LoadMatrix( RI.projectionMatrix );
+		pglMatrixMode( GL_MODELVIEW );
+	}
 }
 
