diff --git a/cl_dll/view.cpp b/cl_dll/view.cpp
index fd4e54e..3cb65a8 100644
--- a/cl_dll/view.cpp
+++ b/cl_dll/view.cpp
@@ -37,9 +37,11 @@ static int MsgFunc_HlGuarda( const char *pszName, int iSize, void *pbuf )
 	BEGIN_READ( pbuf, iSize );
 	g_iHlGuarda = READ_BYTE();
 
-	// sacar: a animação de sacar da arma já traz ela de baixo
+	// sacar: a animação de sacar da arma já traz ela de baixo; 3: já estava guardada (save carregado)
 	if( !g_iHlGuarda )
 		g_flHlGuarda = 0.0f;
+	else if( g_iHlGuarda == 3 )
+		g_flHlGuarda = 1.0f;
 
 	return 1;
 }
@@ -792,15 +794,20 @@ void V_CalcNormalRefdef( struct ref_params_s *pparams )
 		vec3_t vFrente, vDireita, vCima;
 		float s;
 
-		g_flHlGuarda += pparams->frametime / 0.45f;
+		// 1: a arma tem animação de guardar, então desce pouco e devagar no começo;
+		// 2 e 3: a arma só desce, então vai rápido e longe o bastante para sair da tela antes de sumir
+		const int bAnimada = ( g_iHlGuarda == 1 );
+		const float flDistancia = bAnimada ? 16.0f : 40.0f;
+
+		g_flHlGuarda += pparams->frametime / ( bAnimada ? 0.45f : 0.4f );
 		if( g_flHlGuarda > 1.0f )
 			g_flHlGuarda = 1.0f;
 
-		s = g_flHlGuarda * g_flHlGuarda;
+		s = bAnimada ? g_flHlGuarda * g_flHlGuarda : g_flHlGuarda * g_flHlGuarda * ( 3.0f - 2.0f * g_flHlGuarda );
 		AngleVectors( view->angles, vFrente, vDireita, vCima );
 
 		for( i = 0; i < 3; i++ )
-			view->origin[i] -= vCima[i] * 16.0f * s + vFrente[i] * 4.0f * s;
+			view->origin[i] -= vCima[i] * flDistancia * s + vFrente[i] * 4.0f * s;
 
 		if( g_flHlGuarda >= 1.0f )
 			view->model = NULL;
