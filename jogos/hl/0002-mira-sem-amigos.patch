+// hlios: alvo da mira assistida: quem está contra o jogador (inclusive um aliado provocado), ou quem o
+// jogador detesta e não é aliado dele. Cientistas, guardas e soldados aliados (Opposing Force) ficam de fora.
+BOOL CBasePlayer::AutoaimAlvoValido( CBaseEntity *pEntity )
+{
+	CBaseMonster *pMonster = pEntity->MyMonsterPointer();
+	const int iDele = pMonster ? pMonster->IRelationship( this ) : R_NO;
+
+	if( iDele > R_NO )
+		return TRUE;
+
+	return ( IRelationship( pEntity ) > R_NO && iDele != R_AL );
+}
