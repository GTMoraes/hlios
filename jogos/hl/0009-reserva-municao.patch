diff --git a/dlls/game.cpp b/dlls/game.cpp
index 4305ffe..7842631 100644
--- a/dlls/game.cpp
+++ b/dlls/game.cpp
@@ -31,6 +31,26 @@ cvar_t sv_aim_assist = { "sv_aim_assist", "0", FCVAR_SERVER };
 cvar_t sv_doze_pellets = { "sv_doze_pellets", "2", FCVAR_SERVER | FCVAR_ARCHIVE };
 cvar_t sv_doze_dano = { "sv_doze_dano", "1.5", FCVAR_SERVER | FCVAR_ARCHIVE };
 
+// hlios: reservas de munição (weapons.h): sv_municao multiplica todas e sv_municao_uranio é a do urânio
+cvar_t sv_municao = { "sv_municao", "3", FCVAR_SERVER | FCVAR_ARCHIVE };
+cvar_t sv_municao_uranio = { "sv_municao_uranio", "500", FCVAR_SERVER | FCVAR_ARCHIVE };
+
+int HL_Reserva( int original )
+{
+	float m = sv_municao.value > 0.0f ? sv_municao.value : 1.0f;
+	int n = (int)( original * m + 0.5f );
+
+	// o HUD e o clientdata levam até 32767 (patch 0007 do motor)
+	return n < 1 ? 1 : ( n > 9999 ? 9999 : n );
+}
+
+int HL_ReservaUranio( int original )
+{
+	int n = (int)( sv_municao_uranio.value + 0.5f );
+
+	return n < 1 ? original : ( n > 9999 ? 9999 : n );
+}
+
 // quantos pellets saem num tiro que no original solta "original" (de 1 a 64)
 int HL_DozePellets( int original )
 {
