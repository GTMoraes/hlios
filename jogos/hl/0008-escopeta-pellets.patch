diff --git a/dlls/game.cpp b/dlls/game.cpp
index 17821cb..4305ffe 100644
--- a/dlls/game.cpp
+++ b/dlls/game.cpp
@@ -25,6 +25,29 @@ cvar_t displaysoundlist = {"displaysoundlist","0"};
 // hlios: mira assistida para controles de toque (0 = como o original; 1, 2, 3 = força, vale também no Difícil)
 cvar_t sv_aim_assist = { "sv_aim_assist", "0", FCVAR_SERVER };
 
+// hlios: escopeta do jogador na campanha. sv_doze_pellets multiplica os pellets de cada tiro (6 no simples,
+// 12 no duplo) e sv_doze_dano multiplica o dano cheio (todos os pellets pegando), que se divide entre eles.
+// 1 e 1 é o original
+cvar_t sv_doze_pellets = { "sv_doze_pellets", "2", FCVAR_SERVER | FCVAR_ARCHIVE };
+cvar_t sv_doze_dano = { "sv_doze_dano", "1.5", FCVAR_SERVER | FCVAR_ARCHIVE };
+
+// quantos pellets saem num tiro que no original solta "original" (de 1 a 64)
+int HL_DozePellets( int original )
+{
+	int n = (int)( original * sv_doze_pellets.value + 0.5f );
+
+	return n < 1 ? 1 : ( n > 64 ? 64 : n );
+}
+
+// o dano de cada pellet, em vezes o do skill.cfg: o dano cheio do tiro simples vezes sv_doze_dano, dividido
+// entre os pellets dele
+float HL_DozeFatorDano( void )
+{
+	float dano = sv_doze_dano.value > 0.0f ? sv_doze_dano.value : 0.0f;
+
+	return dano * 6.0f / (float)HL_DozePellets( 6 );
+}
+
 // multiplayer server rules
 cvar_t fragsleft	= { "mp_fragsleft","0", FCVAR_SERVER | FCVAR_UNLOGGED };	  // Don't spam console/log files/users with this changing
 cvar_t timeleft		= { "mp_timeleft","0" , FCVAR_SERVER | FCVAR_UNLOGGED };	  // "      "
@@ -491,6 +514,8 @@ void GameDLLInit( void )
 
 	CVAR_REGISTER( &displaysoundlist );
 	CVAR_REGISTER( &sv_aim_assist );
+	CVAR_REGISTER( &sv_doze_pellets );
+	CVAR_REGISTER( &sv_doze_dano );
 	CVAR_REGISTER( &allow_spectators );
 
 	CVAR_REGISTER( &teamplay );
