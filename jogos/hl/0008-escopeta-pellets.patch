+// hlios: os furos e faíscas da escopeta na campanha acompanham o número de pellets do servidor
+// (sv_doze_pellets, em dlls/game.cpp)
+static int EV_DozePellets( int original )
+{
+	float m = gEngfuncs.pfnGetCvarFloat( "sv_doze_pellets" );
+	int n;
+
+	if( m <= 0.0f )
+		m = 1.0f;
+
+	n = (int)( original * m + 0.5f );
+	return n < 1 ? 1 : ( n > 64 ? 64 : n );
+}
