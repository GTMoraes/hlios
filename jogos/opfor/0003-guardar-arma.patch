+// hlios: impulse 200; sacar de novo também acontece ao escolher qualquer arma
+void CBasePlayer::GuardarOuSacarArma( void )
+{
+	if( !m_pActiveItem )
+		return;
+
+	if( m_bArmaGuardada )
+	{
+		m_bArmaGuardada = FALSE;
+		m_pActiveItem->Deploy();
+		return;
+	}
+
+	if( !m_pActiveItem->CanHolster() )
+		return;
+
+	m_pActiveItem->Holster();
+	m_bArmaGuardada = TRUE;
+	m_flGuardarTempo = gpGlobals->time + 0.5f;
+	m_flNextAttack = UTIL_WeaponTimeBase() + 0.5f;
+}
